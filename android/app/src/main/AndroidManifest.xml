<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 没有网络权限：这个 App 从物理上就无法联网 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Android 11+ 包可见性：不声明这些，就查不到/起不来别家的文件管理器 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="vnd.android.document/directory" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="resource/folder" />
        </intent>
        <package android:name="com.android.fileexplorer" />
        <package android:name="com.mi.android.globalFileexplorer" />
        <package android:name="com.oplus.filemanager" />
        <package android:name="com.coloros.filemanager" />
        <package android:name="com.oppo.filemanager" />
        <package android:name="com.oneplus.filemanager" />
        <package android:name="com.vivo.filemanager" />
        <package android:name="com.bbk.fileexplorer" />
        <package android:name="com.huawei.hidisk" />
        <package android:name="com.huawei.filemanager" />
        <package android:name="com.hihonor.filemanager" />
        <package android:name="com.sec.android.app.myfiles" />
        <package android:name="com.meizu.filemanager" />
        <package android:name="com.zui.filemanager" />
        <package android:name="com.android.documentsui" />
        <package android:name="com.google.android.documentsui" />
    </queries>

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher"
        android:label="声影工坊"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:targetApi="33">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="声影工坊"
            android:configChanges="orientation|screenSize|keyboardHidden">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 别的应用「分享」视频/音频过来也能直接接住 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AudioEditorActivity"
            android:exported="false"
            android:label="音频剪辑器"
            android:configChanges="orientation|screenSize|keyboardHidden" />
    </application>

</manifest>
